def betaWeightedSumMCA9 (i m : ℕ) (r H : ℤ) : ℤ :=
 ∑ k ∈ range (m+1), ((i+k).choose i:ℤ)*((i+(m-k)).choose i:ℤ)*
   (r-k)*(r-((m-k:ℕ):ℤ))*betaScalarMCA9 ((i:ℤ)+1) H k ((m-k:ℕ):ℤ)

