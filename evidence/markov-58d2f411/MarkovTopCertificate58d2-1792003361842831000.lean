theorem topGap_nonneg58 (i j : ℕ) (b : ℝ) (hb : 0 ≤ b)
 (hc : 2*b ≤ (i:ℝ)+j) (hd : 2 ≤ i+j) : 0 ≤ topGap58 i j b := by
 rcases i with _ | (_ | i)
 · have hj : 2 ≤ j := by omega
   obtain ⟨k,rfl⟩ := Nat.exists_eq_add_of_le hj
   have h := topGap_nonneg_zero58 0 k b (by norm_num) (by positivity) hb (by push_cast at *; linarith)
   simpa [Nat.cast_add,add_comm] using h
 · have hj : 1 ≤ j := by omega
   obtain ⟨k,rfl⟩ := Nat.exists_eq_add_of_le hj
   have h := topGap_nonneg_one58 0 k b (by norm_num) (by positivity) hb (by push_cast at *; linarith)
   simpa [Nat.cast_add,add_comm] using h
 · simpa [Nat.cast_add,add_comm,add_left_comm,add_assoc] using
     topGap_nonneg_large58 i j b (by positivity) (by positivity) hb (by push_cast at *; linarith)

