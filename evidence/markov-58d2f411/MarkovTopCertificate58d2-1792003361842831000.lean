def topGap58 (i j b : ℝ) : ℝ :=
 let d := i+j
 let n := d+1-b
 let c := b*n+n-3*b-1
 (n-1)*d*(d-1)*(i+2)*(n*(i+1)+b*j)^2 -
 n*(i+1)*(d+2)*(d+1)*(n*(n-1)*i*(i-1)+2*c*i*j+b*(b-1)*j*(j-1))

