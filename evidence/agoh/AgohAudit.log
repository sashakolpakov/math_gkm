DECLARATION MathGKM.Agoh.alternating_monomial
TYPE ∀ (n k : ℕ) (c : ℝ),
  MathGKM.Agoh.alternating n ((Polynomial.monomial k) c) = Polynomial.C c * (1 - Polynomial.X ^ k) ^ n
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.alternating_dvd
TYPE ∀ (n : ℕ) (g : Polynomial ℝ), (Polynomial.X - Polynomial.C 1) ^ n ∣ MathGKM.Agoh.alternating n g
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.coprime_at_one
TYPE ∀ (f : Polynomial ℝ), Polynomial.eval 1 f ≠ 0 → IsCoprime (Polynomial.X - Polynomial.C 1) f
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.power_dvd_comp
TYPE ∀ (n i : ℕ) (q : Polynomial ℝ),
  (Polynomial.X - Polynomial.C 1) ^ n ∣ q → (Polynomial.X - Polynomial.C 1) ^ n ∣ q.comp (Polynomial.X ^ i)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.main_regular
TYPE ∀ (n : ℕ) (f : Polynomial ℝ),
  Polynomial.eval 1 f ≠ 0 → (Polynomial.X - Polynomial.C 1) ^ n ∣ MathGKM.Agoh.numerator n f
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.main
TYPE ∀ (n : ℕ) (f : Polynomial ℝ), (Polynomial.X - Polynomial.C 1) ^ n ∣ MathGKM.Agoh.numerator n f
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.denominator_eval_one
TYPE ∀ (n : ℕ) (f : Polynomial ℝ), Polynomial.eval 1 (MathGKM.Agoh.denominator n f) = Polynomial.eval 1 f ^ (n + 1)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.denominator_ne_zero
TYPE ∀ (n : ℕ) (f : Polynomial ℝ), Polynomial.eval 1 f ≠ 0 → MathGKM.Agoh.denominator n f ≠ 0
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.rationalSum_eq_fraction
TYPE ∀ (n : ℕ) (f : Polynomial ℝ),
  Polynomial.eval 1 f ≠ 0 →
    MathGKM.Agoh.rationalSum n f =
      (algebraMap (Polynomial ℝ) (RatFunc ℝ)) (MathGKM.Agoh.numerator n f) /
        (algebraMap (Polynomial ℝ) (RatFunc ℝ)) (MathGKM.Agoh.denominator n f)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.reduced_numerator
TYPE ∀ (n : ℕ) (f : Polynomial ℝ),
  Polynomial.eval 1 f ≠ 0 → (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n f).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.cleared_iff_reduced
TYPE ∀ (n m : ℕ) (f : Polynomial ℝ),
  Polynomial.eval 1 f ≠ 0 →
    ((Polynomial.X - Polynomial.C 1) ^ m ∣ MathGKM.Agoh.numerator n f ↔
      (Polynomial.X - Polynomial.C 1) ^ m ∣ (MathGKM.Agoh.rationalSum n f).num)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.theorem_1_1
TYPE ∀ (n : ℕ) (a : ℝ),
  a ≠ -1 → (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n (Polynomial.X + Polynomial.C a)).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.paper_H
TYPE ∀ (n : ℕ) (a : ℝ),
  MathGKM.Agoh.numerator n (Polynomial.X + Polynomial.C a) =
    ∑ i ∈ Finset.range (n + 1),
      Polynomial.C ((-1) ^ i * ↑(n.choose i)) *
        ∏ k ∈ (Finset.range (n + 1)).erase i, (Polynomial.X ^ k + Polynomial.C a)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.paper_G
TYPE ∀ (n : ℕ) (a x : ℝ),
  (∀ i ∈ Finset.range (n + 1), x ^ i + a ≠ 0) →
    Polynomial.eval x (MathGKM.Agoh.numerator n (Polynomial.X + Polynomial.C a)) =
      (∏ k ∈ Finset.range (n + 1), (x ^ k + a)) * ∑ i ∈ Finset.range (n + 1), (-1) ^ i * ↑(n.choose i) / (x ^ i + a)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.theorem_3_1
TYPE ∀ (n : ℕ) (f : Polynomial ℝ),
  0 < f.natDegree →
    f.Splits →
      Squarefree f → Polynomial.eval 1 f ≠ 0 → (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n f).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeated_root_family
TYPE ∀ (n j : ℕ) (b : ℝ),
  b ≠ 1 → (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n ((Polynomial.X - Polynomial.C b) ^ j)).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.simple_roots_iff_squarefree
TYPE ∀ (f : Polynomial ℝ), f ≠ 0 → f.Splits → (f.roots.Nodup ↔ Squarefree f)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeatedExample_regular
TYPE Polynomial.eval 1 MathGKM.Agoh.repeatedExample ≠ 0
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeatedExample_nonzero
TYPE MathGKM.Agoh.repeatedExample ≠ 0
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeatedExample_splits
TYPE MathGKM.Agoh.repeatedExample.Splits
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeatedExample_not_monomial
TYPE ¬∃ k c, MathGKM.Agoh.repeatedExample = (Polynomial.monomial k) c
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeatedExample_not_squarefree
TYPE ¬Squarefree MathGKM.Agoh.repeatedExample
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeatedExample_not_alternatives
TYPE ¬MathGKM.Agoh.PaperAlternatives MathGKM.Agoh.repeatedExample
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.repeatedExample_all_n
TYPE ∀ (n : ℕ), (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n MathGKM.Agoh.repeatedExample).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.refutes_per_n
TYPE ∀ (n : ℕ), ¬MathGKM.Agoh.ConjecturePerN n
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.refutes_all_n
TYPE ¬MathGKM.Agoh.ConjectureAllN
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.all_n_iff_positive
TYPE ∀ (f : Polynomial ℝ),
  (∀ (n : ℕ), (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n f).num) ↔
    ∀ (n : ℕ), 0 < n → (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n f).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.complex_root_example
TYPE ∀ (n : ℕ), (Polynomial.X - Polynomial.C 1) ^ n ∣ (MathGKM.Agoh.rationalSum n (Polynomial.X ^ 2 + 1)).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.H_two
TYPE ∀ (a : ℝ),
  MathGKM.Agoh.numerator 2 (Polynomial.X + Polynomial.C a) = (Polynomial.X - 1) ^ 2 * (Polynomial.X - Polynomial.C a)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.H_three
TYPE ∀ (a : ℝ),
  MathGKM.Agoh.numerator 3 (Polynomial.X + Polynomial.C a) =
    (Polynomial.X - 1) ^ 3 *
      (Polynomial.X ^ 3 - Polynomial.C (2 * a) * Polynomial.X ^ 2 - Polynomial.C (2 * a) * Polynomial.X +
        Polynomial.C (a ^ 2))
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.extra_factor_three
TYPE ∀ (a : ℝ),
  a ^ 2 - 4 * a + 1 = 0 → (Polynomial.X - Polynomial.C 1) ^ 4 ∣ MathGKM.Agoh.numerator 3 (Polynomial.X + Polynomial.C a)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.extra_factor_radicals
TYPE (Polynomial.X - Polynomial.C 1) ^ 4 ∣ (MathGKM.Agoh.rationalSum 3 (Polynomial.X + Polynomial.C (2 + √3))).num ∧
  (Polynomial.X - Polynomial.C 1) ^ 4 ∣ (MathGKM.Agoh.rationalSum 3 (Polynomial.X + Polynomial.C (2 - √3))).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.section_four_polynomial
TYPE MathGKM.Agoh.numerator 1 MathGKM.Agoh.repeatedExample =
  Polynomial.X ^ 2 + Polynomial.C 2 * Polynomial.X - Polynomial.C 3
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.section_four_degree
TYPE (MathGKM.Agoh.numerator 1 MathGKM.Agoh.repeatedExample).natDegree = 2
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.cancellation_without_regularity
TYPE Polynomial.X - Polynomial.C 1 ∣ Polynomial.X - Polynomial.C 1 ∧
  ¬Polynomial.X - Polynomial.C 1 ∣
      ((algebraMap (Polynomial ℝ) (RatFunc ℝ)) (Polynomial.X - Polynomial.C 1) /
          (algebraMap (Polynomial ℝ) (RatFunc ℝ)) (Polynomial.X - Polynomial.C 1)).num
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.clears_denominators
TYPE ∀ (n : ℕ) (f : Polynomial ℝ) (x : ℝ),
  (∀ i ∈ Finset.range (n + 1), Polynomial.eval (x ^ i) f ≠ 0) →
    Polynomial.eval x (MathGKM.Agoh.numerator n f) =
      (∏ k ∈ Finset.range (n + 1), Polynomial.eval (x ^ k) f) *
        ∑ i ∈ Finset.range (n + 1), (-1) ^ i * ↑(n.choose i) / Polynomial.eval (x ^ i) f
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.zero_order
TYPE ∀ (f : Polynomial ℝ), MathGKM.Agoh.numerator 0 f = 1
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.first_order_factor
TYPE ∀ (n : ℕ), n ≠ 0 → ∀ (f : Polynomial ℝ), Polynomial.X - Polynomial.C 1 ∣ MathGKM.Agoh.numerator n f
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.singular_counterexample
TYPE Polynomial.eval 2 (MathGKM.Agoh.numerator 1 (Polynomial.X - 1)) = 1 ∧
  ∏ k ∈ Finset.range 2, Polynomial.eval (2 ^ k) (Polynomial.X - 1) = 0
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.missing_positive_n
TYPE ¬Polynomial.X - Polynomial.C 1 ∣ MathGKM.Agoh.numerator 0 (Polynomial.X + 1)
AXIOMS [propext, Classical.choice, Quot.sound]
DECLARATION MathGKM.Agoh.geometric_region_counterexample
TYPE 2 < 3 ∧ |7 / 5 - 1| < 1 / 2 ∧ ¬|(7 / 5) ^ 4 / 3| < 1
AXIOMS [propext, Classical.choice, Quot.sound]
