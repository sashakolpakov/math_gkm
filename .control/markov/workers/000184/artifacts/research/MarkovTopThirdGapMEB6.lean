 rw [top_mass_short_sumMEB6]
 simp only [topShortSumMEB6,topShortQMEB6,Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,
   Int.cast_sum,Int.cast_add,Int.cast_mul,Int.cast_natCast,Int.cast_ofNat,choose_poly_natM0D3]
