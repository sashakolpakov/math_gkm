def topShortQMEB6 (d T : ℚ) (i : ℕ) : ℚ :=
 ∑ k ∈ range (i+4), ((i+k).choose i:ℚ)*choosePolyM0D3 (d+2*i+8) (i+3-k)*
 (choosePolyM0D3 T (i+k)+4*choosePolyM0D3 (T+1) (i+k+2))

theorem top_short_castMEB6 (d T i : ℕ) :
