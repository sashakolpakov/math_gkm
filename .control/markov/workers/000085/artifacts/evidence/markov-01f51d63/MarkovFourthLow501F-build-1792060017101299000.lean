   have h7 : j≠7 := by omega
   simp only [Polynomial.coeff_add,Polynomial.coeff_C_mul,Polynomial.coeff_X_pow]
   simp [hseq,h0,h1,h2,h3,h4,h5,h6,h7,eq_comm]
end
end MathGKM.Markov
