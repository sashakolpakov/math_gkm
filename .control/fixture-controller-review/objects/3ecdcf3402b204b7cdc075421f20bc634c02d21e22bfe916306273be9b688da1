MathGKM.Continuation.main (n : ℕ) (s : MathGKM.Continuation.State) (env : MathGKM.Continuation.Environment)
  (reward : List MathGKM.Continuation.View → ℤ) (profitable : MathGKM.Continuation.changeCost s < s.engine.padding) :
  (MathGKM.Continuation.run (n + 1) (MathGKM.Continuation.strip s) env).observations =
      (MathGKM.Continuation.run (n + 1) s env).observations ∧
    MathGKM.Continuation.Refines (MathGKM.Continuation.run (n + 1) (MathGKM.Continuation.strip s) env).state
        (MathGKM.Continuation.run (n + 1) s env).state ∧
      MathGKM.Continuation.utility reward (MathGKM.Continuation.run (n + 1) s env) <
        MathGKM.Continuation.utility reward (MathGKM.Continuation.switchRun (n + 1) s env)
MathGKM.Continuation.installed_main (n : ℕ) (s : MathGKM.Continuation.State) (r : MathGKM.Continuation.Result)
  (env : MathGKM.Continuation.Environment) (reward : List MathGKM.Continuation.View → ℤ)
  (accepted : MathGKM.Continuation.tryChange s = some r) :
  (MathGKM.Continuation.afterChange (n + 1) r env).observations =
      (MathGKM.Continuation.run (n + 1) s env).observations ∧
    MathGKM.Continuation.utility reward (MathGKM.Continuation.run (n + 1) s env) <
      MathGKM.Continuation.utility reward (MathGKM.Continuation.afterChange (n + 1) r env)
MathGKM.Continuation.verified_change (n : ℕ) (s : MathGKM.Continuation.State) (r : MathGKM.Continuation.Result)
  (env : MathGKM.Continuation.Environment) (reward : List MathGKM.Continuation.View → ℤ)
  (accepted : MathGKM.Continuation.tryChange s = some r) :
  MathGKM.Continuation.Execution env (n + 1) s (MathGKM.Continuation.run (n + 1) s env).state
      (MathGKM.Continuation.run (n + 1) s env).cost ∧
    (∃ continuationCost,
        MathGKM.Continuation.Execution env (n + 1) r.state (MathGKM.Continuation.afterChange (n + 1) r env).state
            continuationCost ∧
          (MathGKM.Continuation.afterChange (n + 1) r env).cost = r.cost + continuationCost) ∧
      (MathGKM.Continuation.afterChange (n + 1) r env).observations =
          (MathGKM.Continuation.run (n + 1) s env).observations ∧
        MathGKM.Continuation.utility reward (MathGKM.Continuation.run (n + 1) s env) <
          MathGKM.Continuation.utility reward (MathGKM.Continuation.afterChange (n + 1) r env)
MathGKM.Continuation.additional_change_cost (extra n : ℕ) (s : MathGKM.Continuation.State)
  (env : MathGKM.Continuation.Environment) (reward : List MathGKM.Continuation.View → ℤ)
  (bound : extra + MathGKM.Continuation.changeCost s < s.engine.padding) :
  MathGKM.Continuation.utility reward (MathGKM.Continuation.run (n + 1) s env) <
    MathGKM.Continuation.utility reward
      (MathGKM.Continuation.afterChange (n + 1)
        { state := MathGKM.Continuation.strip s, cost := extra + MathGKM.Continuation.changeCost s } env)
MathGKM.Continuation.deadline_preservation (s : MathGKM.Continuation.State) (env : MathGKM.Continuation.Environment)
  (profitable : MathGKM.Continuation.changeCost s < s.engine.padding) (j budget : ℕ)
  (P : MathGKM.Continuation.View → Prop)
  (success : P (MathGKM.Continuation.view (MathGKM.Continuation.run (j + 1) s env).state))
  (in_time : (MathGKM.Continuation.run (j + 1) s env).cost ≤ budget) :
  P (MathGKM.Continuation.view (MathGKM.Continuation.run (j + 1) (MathGKM.Continuation.strip s) env).state) ∧
    MathGKM.Continuation.changeCost s + (MathGKM.Continuation.run (j + 1) (MathGKM.Continuation.strip s) env).cost ≤
      budget
MathGKM.Gluing.universal {A B C : Type} (f : A → B) (g : A → C) {D : Type} (u : B → D) (v : C → D)
  (compatible : ∀ (a : A), u (f a) = v (g a)) :
  ∃! w, (∀ (b : B), w (MathGKM.Gluing.left f g b) = u b) ∧ ∀ (c : C), w (MathGKM.Gluing.right f g c) = v c
