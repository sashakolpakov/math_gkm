theorem binomial_poly_0M295 (x : ℚ) :
 choosePolyM0D3 x 0 = (
  (1)
 ) / 1 := by
 simp [choose_poly_zeroM0D3]

theorem binomial_poly_1M295 (x : ℚ) :
 choosePolyM0D3 x 1 = (
  (1) * x
 ) / 1 := by
 have h := choose_poly_succM0D3 x 0
 norm_num only at h
 rw [h,binomial_poly_0M295]
 ring

theorem binomial_poly_2M295 (x : ℚ) :
